FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY . .
RUN npm ci --no-audit --no-fund
ARG APP
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FIREBASE_CONFIG
ARG NEXT_PUBLIC_FIREBASE_VAPID_KEY
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_APPLE_CLIENT_ID
ARG NEXT_PUBLIC_APPLE_REDIRECT_URI
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID NEXT_PUBLIC_APPLE_CLIENT_ID=$NEXT_PUBLIC_APPLE_CLIENT_ID NEXT_PUBLIC_APPLE_REDIRECT_URI=$NEXT_PUBLIC_APPLE_REDIRECT_URI
ARG NEXT_PUBLIC_MAP_TILE_URL
ARG NEXT_PUBLIC_SERVICE_AREA_LATITUDE
ARG NEXT_PUBLIC_SERVICE_AREA_LONGITUDE
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_FIREBASE_CONFIG=$NEXT_PUBLIC_FIREBASE_CONFIG NEXT_PUBLIC_FIREBASE_VAPID_KEY=$NEXT_PUBLIC_FIREBASE_VAPID_KEY NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY NEXT_PUBLIC_MAP_TILE_URL=$NEXT_PUBLIC_MAP_TILE_URL NEXT_PUBLIC_SERVICE_AREA_LATITUDE=$NEXT_PUBLIC_SERVICE_AREA_LATITUDE NEXT_PUBLIC_SERVICE_AREA_LONGITUDE=$NEXT_PUBLIC_SERVICE_AREA_LONGITUDE
RUN npm run build --workspace=@repo/i18n && npm exec --workspace="$APP" -- next build --webpack
FROM build AS server
ARG APP
ENV APP=$APP NODE_ENV=production
RUN chown -R node:node /app/apps/$APP/.next
USER node
CMD ["sh", "-c", "npm run start --workspace=\"$APP\""]
FROM nginx:stable-alpine AS static
ARG APP
COPY --from=build /app/apps/${APP}/out /usr/share/nginx/html
