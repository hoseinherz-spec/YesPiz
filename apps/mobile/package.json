{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8051",
    "build": "next build",
    "start": "next start --port 8051",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "android:apk": "npm run cap:sync && npm run android:apk:only",
    "android:apk:only": "cd android && gradlew.bat assembleRelease",
    "android:aab": "npm run cap:sync && npm run android:aab:only",
    "android:aab:only": "cd android && gradlew.bat bundleRelease",
    "ios:export": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "@repo/api": "*",
    "@repo/i18n": "*",
    "@repo/icons": "*",
    "@repo/theme": "*",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
