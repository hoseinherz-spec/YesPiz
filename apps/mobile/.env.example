# Nest API (Phase 1) — used by @repo/api
NEXT_PUBLIC_API_URL=http://localhost:8058

# Stripe (optional — without these, card payments use server mock capture)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Masked call/chat — hide until a real provider is wired
NEXT_PUBLIC_MASKED_COMMS_ENABLED=false

NEXT_PUBLIC_FIREBASE_CONFIG=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_SERVICE_AREA_LATITUDE=
NEXT_PUBLIC_SERVICE_AREA_LONGITUDE=
