# Nest API (Phase 1) — used by @repo/api
NEXT_PUBLIC_API_URL=http://localhost:8058

# Stripe (optional — without these, card payments use server mock capture)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Masked call/chat — hide until a real provider is wired
NEXT_PUBLIC_MASKED_COMMS_ENABLED=false

NEXT_PUBLIC_FIREBASE_CONFIG=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_SERVICE_AREA_LATITUDE=
NEXT_PUBLIC_SERVICE_AREA_LONGITUDE=

# Social sign-in (web OAuth clients; public IDs, never client secrets)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Facebook Login (must match API application configuration)
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_API_VERSION=

# Native OAuth and wallets: IDs must match registered app/signing certificates.
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
NEXT_PUBLIC_APPLE_PAY_MERCHANT_ID=
NEXT_PUBLIC_GOOGLE_PAY_ENABLED=false
NEXT_PUBLIC_PAYMENT_COUNTRY=DE
