PORT=8058
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/yespizz
JWT_SECRET=change-me-in-production-use-32plus-chars
JWT_EXPIRES_IN=7d

# Comma-separated browser origins (required in production)
CORS_ORIGINS=http://localhost:8051,http://localhost:8052,http://localhost:8053,http://localhost:8084

# Set true only temporarily in production; default off when NODE_ENV=production
SWAGGER_ENABLED=

# First-admin bootstrap secret (required in production for bootstrap-admin)
BOOTSTRAP_ADMIN_SECRET=

# Redis (optional — in-memory lock fallback when unset)
REDIS_URL=

# Twilio OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Ignored when NODE_ENV=production
OTP_DEV_BYPASS=true

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=

# Stripe (optional — mock capture when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# FCM push (optional)
FCM_SERVER_KEY=

# Seed defaults
SEED_ADMIN_EMAIL=admin@yespizz.local
SEED_ADMIN_PASSWORD=Admin123!
