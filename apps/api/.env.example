PORT=8058
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/yespizz
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Redis (optional — in-memory lock fallback when unset)
REDIS_URL=

# Twilio OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_DEV_BYPASS=true

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=

# Stripe (optional — mock capture when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key for mobile/web Stripe.js clients (not used by API)
STRIPE_PUBLISHABLE_KEY=

# FCM push (optional — logs + stores notifications when unset)
FCM_SERVER_KEY=

# Seed defaults
SEED_ADMIN_EMAIL=admin@yespizz.local
SEED_ADMIN_PASSWORD=Admin123!
