{
  "name": "yespizz",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace=@repo/i18n && npm run build --workspaces --if-present",
    "dev": "turbo run dev",
    "dev:website": "turbo run dev --filter=website",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:courier": "turbo run dev --filter=courier-mobile",
    "dev:provider": "turbo run dev --filter=provider-panel",
    "dev:api": "turbo run dev --filter=api",
    "swagger:export": "npm run swagger:export --workspace=api",
    "mobile:apk": "npm run android:apk --workspace=mobile",
    "mobile:aab": "npm run android:aab --workspace=mobile",
    "mobile:ios": "npm run ios:export --workspace=mobile",
    "courier:apk": "npm run android:apk --workspace=courier-mobile",
    "courier:aab": "npm run android:aab --workspace=courier-mobile",
    "courier:ios": "npm run ios:export --workspace=courier-mobile",
    "start": "turbo run start",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "npm run check-types --workspaces --if-present",
    "test": "npm run test --workspace=api -- --runInBand --watchman=false && npm run test:forms --workspace=@repo/ui",
    "test:e2e:features": "playwright test --config=playwright.features.config.ts",
    "seed:api": "npm run seed --workspace=api",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "postinstall": "npm run sync-assets --workspace=@repo/animated-icons && node scripts/native-compat.cjs",
    "test:stripe-sandbox": "npm run build --workspace=@repo/i18n && npm run test:stripe-sandbox --workspace=api",
    "test:stripe-browser": "playwright test --config=playwright.stripe.config.ts",
    "stripe:listen": "node scripts/stripe-webhook.cjs",
    "test:e2e:review": "node e2e/run-role-review.cjs",
    "test:customer-ux": "node scripts/test-customer-ux.cjs",
    "dev:mock-api": "TEST_STRIPE_SANDBOX=0 node e2e/start-api.cjs",
    "sandbox:stripe": "node scripts/setup-stripe-sandbox.cjs",
    "sandbox:sms": "node scripts/setup-twilio-sandbox.cjs",
    "sms:setup": "node scripts/setup-twilio-sandbox.cjs",
    "native:configure": "node scripts/configure-native-services.cjs",
    "demo": "npm run build --workspace=@repo/i18n && node scripts/demo.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
